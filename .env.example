BOT_TOKEN=123456789:replace-with-token-from-botfather
# Only needed for the webhook (flask_app.py), not for poll.py.
# Any long random string; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-random-string

# GitLab lets the bot set the reviewer on the MR, and lets /my and the reminders
# see which MRs are approved. The token needs the api scope and the Developer role
# (read_api and Reporter are enough if you don't want reviewers set in GitLab).
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-with-gitlab-token

# Reminders about open MRs go to the group on weekdays at these times.
TIMEZONE=Asia/Almaty
REMIND_TIMES=09:00,14:00
